<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LineVision.Core\LineVision.Core.csproj" />
    <ProjectReference Include="..\LineVision.Infrastructure\LineVision.Infrastructure.csproj" />
    <ProjectReference Include="..\LineVision.Vision\LineVision.Vision.csproj" />
    <ProjectReference Include="..\LineVision.Service\LineVision.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\sql\**\*.*">
      <Link>sql\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeDllsToRoot" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\OpenCvSharpExtern.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(OutputPath)runtimes\win-x64\native\OpenCvSharpExtern.dll')" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)runtimes\win-x64\native\OpenCvSharpExtern.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\OpenCvSharpExtern.dll')" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\e_sqlite3.dll')" ContinueOnError="true" />
  </Target>

</Project>
